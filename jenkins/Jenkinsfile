pipeline {
    agent any

    options {
        skipStagesAfterUnstable()
    }

    stages {
        stage('Setup dependencies') {
            steps {
                bat '"C:\\Users\\ivanz\\AppData\\Local\\Python\\bin\\python.exe" --version'
                bat '"C:\\Users\\ivanz\\AppData\\Local\\Python\\bin\\python.exe" -m pip install -r requirements.txt'
                bat '"C:\\Users\\ivanz\\AppData\\Local\\Python\\bin\\python.exe" -m pip install pytest'
            }
        }

        stage('Compile') {
            steps {
                bat '"C:\\Users\\ivanz\\AppData\\Local\\Python\\bin\\python.exe" -m compileall -q sources'
            }
        }

        stage('Tests') {
            steps {
                bat 'if not exist reports mkdir reports'
                bat '"C:\\Users\\ivanz\\AppData\\Local\\Python\\bin\\python.exe" -m pytest sources --junitxml=reports/junit.xml'
            }
            post {
                always {
                    junit testResults: 'reports/junit.xml', allowEmptyResults: true
                }
            }
        }

        stage('Archive artifacts') {
            steps {
                archiveArtifacts artifacts: 'sources/**/*.py, reports/junit.xml',
                                 allowEmptyArchive: false
            }
        }
    }
}
