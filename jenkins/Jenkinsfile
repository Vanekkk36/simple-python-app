pipeline {
    agent any

    stages {
        stage('Setup dependencies') {
            steps {
                bat 'python --version'
                bat 'python -m pip install -r requirements.txt'
            }
        }

        stage('Compile') {
            steps {
                bat 'python -m compileall -q sources'
            }
        }

        stage('Tests') {
            steps {
                bat 'if not exist reports mkdir reports'
                bat 'python -m pip install pytest'
                bat 'python -m pytest sources --junitxml=reports/junit.xml'
            }
            post {
                always {
                    junit 'reports/junit.xml'
                }
            }
        }

        stage('Archive artifacts') {
            steps {
                archiveArtifacts artifacts: 'sources/**/*.py, reports/junit.xml',
                                 allowEmptyArchive: false
            }
        }
    }

    options {
        skipStagesAfterUnstable()
    }
}
